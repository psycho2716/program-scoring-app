# Backend (copy to backend/.env)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pageant_scoring
JWT_SECRET=change-this-to-a-long-random-secret
PORT=4000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# For LAN access, replace localhost with your machine IP, e.g.:
# NEXT_PUBLIC_API_URL=http://192.168.1.100:4000
# NEXT_PUBLIC_SOCKET_URL=http://192.168.1.100:4000
